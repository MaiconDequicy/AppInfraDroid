<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#333333"
            app:navigationIcon="@drawable/arrow_back"
            app:navigationIconTint="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="InfraDroid"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_button_remote"
                android:backgroundTint="#CCCCCC" />

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="Controle da Fita Led"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="6">

                <!-- Row 1 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_brightness_up"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="☀️⬆️"
                    android:textSize="12sp"
                    app:cornerRadius="24dp"
                    app:strokeColor="#CCCCCC" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_brightness_down"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="☀️⬇️"
                    android:textSize="12sp"
                    app:cornerRadius="24dp"
                    app:strokeColor="#CCCCCC" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_off"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="OFF"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:backgroundTint="@color/btn_off"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_on"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="ON"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:backgroundTint="@color/btn_on"
                    app:cornerRadius="24dp" />

                <!-- Row 2 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_red"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="RED"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:backgroundTint="@color/btn_red"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_green"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="GREEN"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:backgroundTint="@color/btn_green"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_blue"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="BLUE"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:backgroundTint="@color/btn_blue"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_white"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="WHITE"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="24dp"
                    app:strokeColor="#CCCCCC" />

                <!-- Row 3 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_r1"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="R1"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_r1"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_g1"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="G1"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_g1"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_b1"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="B1"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_b1"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_flash"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="FLASH"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:backgroundTint="@color/btn_func"
                    app:cornerRadius="24dp" />

                <!-- Row 4 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_r2"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="R2"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_r2"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_g2"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="G2"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_g2"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_b2"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="B2"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_b2"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_strobe"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="STROBE"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:backgroundTint="@color/btn_func"
                    app:cornerRadius="24dp" />

                <!-- Row 5 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_r3"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="R3"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_r3"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_g3"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="G3"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_g3"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_b3"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="B3"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_b3"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fade"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="FADE"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:backgroundTint="@color/btn_func"
                    app:cornerRadius="24dp" />

                <!-- Row 6 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_r4"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="R4"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_r4"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_g4"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="G4"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_g4"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_b4"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="B4"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/btn_b4"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_smooth"
                    android:layout_width="65dp"
                    android:layout_height="45dp"
                    android:layout_margin="4dp"
                    android:text="SMOOTH"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:backgroundTint="@color/btn_func"
                    app:cornerRadius="24dp" />

            </GridLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
