<!--
  NOTA PARA DESENVOLVIMENTO:
  A linha 'sharedUserId' abaixo é necessária para o AOSP, mas impede a instalação
  em emuladores ou dispositivos comuns pelo Android Studio.
  Mantenha comentada para testes locais e descomente antes de compilar no AOSP.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="br.iots.appinfradroid">
    <!-- android:sharedUserId="android.uid.system" -->

    <uses-permission android:name="android.permission.TRANSMIT_IR" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppInfraDroid">

        <activity
            android:name=".AddBotao"
            android:exported="false" />
        <activity
            android:name=".BotoesControle"
            android:exported="false" />
        <activity
            android:name=".AddControle"
            android:exported="false" />
        <activity
            android:name=".Home"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
